---
// Shared <head> for every page. Each page passes its own title/description for SEO,
// and optionally `schema`: JSON-LD structured data (one object or a list) for search and answer engines.
import { markdownPath } from '../data/markdown';
interface Props {
  title: string;
  description: string;
  schema?: object | object[];
}
const { title, description, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
// Every page has a markdown copy for AI agents (see data/markdown.ts and /middleware.ts).
const markdownHref = markdownPath(Astro.url.pathname);
// Escape "<" so text inside the JSON can never close the <script> tag early.
const jsonLd = schema && JSON.stringify(schema).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="theme-color" content="#2563eb">
<meta property="og:site_name" content="Just Sign It">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Just Sign It: sign a PDF in your browser. Free, no account.">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="alternate" type="text/markdown" href={markdownHref}>
<link rel="stylesheet" href="/fonts/fonts.css">
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
<!-- Privacy-friendly analytics by Plausible -->
<script is:inline async src="https://plausible.io/js/pa-Mpeoaj_RmqkPmkYpG_UIr.js"></script>
<script is:inline src="/plausible-init.js"></script>
<slot name="head" />
</head>
<body>
<slot />
</body>
</html>
